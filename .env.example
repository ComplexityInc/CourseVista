# CourseVista — environment variable reference
#
# TEMPLATE ONLY. Never put real values in this file; it is committed to git.
# Real values go in Vercel: Project -> Settings -> Environment Variables.
# Names must match EXACTLY — the code looks for these strings.

# --- Stripe -----------------------------------------------------------
# Test keys for Preview + Development, live key for Production ONLY.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Email (Resend) ---------------------------------------------------
# NOTE: the variable is EMAIL_API_KEY, not RESEND_API_KEY.
EMAIL_API_KEY=re_replace_me
EMAIL_FROM=CourseVista <business@send.coursevista.com.au>
EMAIL_REPLY_TO=business@coursevista.com.au
COURSEVISTA_INTERNAL_EMAIL=business@coursevista.com.au

# --- Site -------------------------------------------------------------
SITE_URL=https://www.coursevista.com.au
INVOICE_DAYS_UNTIL_DUE=14
