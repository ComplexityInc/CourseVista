# Copy to .env.local for local runs. NEVER commit real keys — .env* is gitignored,
# and production values live in Vercel → Settings → Environment Variables.
# Test mode: use the sk_test_ / pk_test_ pair from the Stripe dashboard with the
# "Test mode" toggle ON. Nothing charges real money while these are test keys.

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

INVOICE_DAYS_UNTIL_DUE=7
SITE_URL=https://coursevista.com.au
COURSEVISTA_INTERNAL_EMAIL=business@coursevista.com.au
EMAIL_API_KEY=
